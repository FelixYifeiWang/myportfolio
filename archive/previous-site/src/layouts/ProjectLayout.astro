---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  projectName: string;
  backHref: string;
}

const { title, projectName, backHref } = Astro.props;
---
<BaseLayout title={title}>
    <div class="left-column">
        <h1 set:html={projectName} />
        <slot name="metadata" />
        <div class="cat-icon">
            <a href={backHref}><img src="/assets/back.png" alt="Back Icon"></a>
        </div>
    </div>

    <div class="content">
        <slot />
    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            document.body.classList.add('fadein');
            const internalLinks = document.querySelectorAll('a[href^="/selected-works-plain"]');

            internalLinks.forEach(link => {
                link.addEventListener('click', function(event) {
                    if (!this.getAttribute('href')) return;

                    event.preventDefault();

                    const destination = this.href;

                    document.body.classList.add('fadeout');

                    setTimeout(() => {
                        window.location.href = destination;
                    }, 300);
                });
            });
        });
    </script>
</BaseLayout>

<style is:global>
    @keyframes fadeOut {
        from {
            opacity: 1;
            background-color: white;
        }
        to {
            opacity: 0;
            background-color: white;
        }
    }
    @keyframes fadeIn {
        from {
            opacity: 0;
            background-color: white;
        }
        to {
            opacity: 1;
            background-color: white;
        }
    }
    .fadein {
        animation: fadeIn 0.3s ease-in forwards;
    }
    .fadeout {
        animation: fadeOut 0.3s ease-out forwards;
    }
    body {
        margin: 0;
        overflow: hidden;

        background-image: url('/assets/whitebg.png');
        background-size: cover;
        background-attachment: fixed;
        background-position: center;
        background-color: white;
    }

    .left-column {
        position: fixed;
        top: 0;
        left: 0;
        width: 32vw;
        height: 100%;
        padding: 20px;
    }

    .left-column h1 {
        font-size: 3.33vw;
        line-height: 2.33vw;
        font-family: 'Zen Dots', sans-serif;
        font-weight: 300;
        margin-top: 6vh;
        margin-left: 3vw;
    }

    .left-column ul {
        list-style-type: none;
        font-family: 'Poppins', Arial, sans-serif;
        font-weight: 400;
        font-size: max(0.8325vw, 1.75vh);
        padding: 0;
        margin-left: 3vw;
        margin-top: 10vh;
    }

    .left-column ul li {
        margin: 35px 0;
    }

    .left-column ul li a {
        text-decoration: none;
        color: #949494;
    }

    .left-column .immersive-view {
        position: fixed;
        margin-top: 0;
        margin-left: 3vw;
        bottom: 6vh;
        text-align: left;
        font-family: 'Poppins', Arial, sans-serif;
        font-size: max(0.624vw, 1.31vh);
    }

    .left-column .immersive-view button {
        padding: 0.6vw 1.6vw;
        border: 0.18vw solid #333;
        background: none;
        cursor: pointer;
        font-family: 'Poppins', Arial, sans-serif;
        font-size: 1.04vw;
    }

    .left-column .cat-icon {
        position: fixed;
        text-align: left;
        margin-left: 3vw;
        bottom: 6vh;
    }

    .left-column .cat-icon img {
        width: 3vw;
        height: auto;
        transition: opacity 0.2s ease-in-out;
    }

    .left-column .cat-icon img:hover {
        opacity: 0.6;
    }

    .content {
        position: fixed;
        margin-left: 31.6vw;
        top: 27vh;
        width: 67.4vw;
        height: 73vh;
        overflow-y: auto;
        font-family: 'Poppins', Arial, sans-serif;
        scrollbar-width: none;
    }

    .content::-webkit-scrollbar {
        display: none;
    }

    .project {
        margin-bottom: 5.94vw;
        margin-right: 3vw;
    }

    .project img {
        width: 100%;
    }

    .project .illustration {
        text-align: center;
        width: 80%;
        margin-left: 10%;
        margin-top: 6vh;
    }

    .project h2 {
        font-size: max(1.665vw, 3vh);
        font-weight: 400;
        text-align: right;
    }

    .project h3 {
        font-size: max(1.3vw, 2.73vh);
        font-weight: 400;
        text-align: left;
        margin-left: 3vw;
        color: #949494;
    }

    .project p {
        font-size: max(0.8vw, 1.7vh);
        color: black;
        text-align: left;
        margin-left: 3vw;
    }

    #chosen {
        color: black;
    }

    @media (orientation: portrait) {
        .left-column ul{
            display: none;
        }
        .left-column .immersive-view {
            display: none;
        }
        .left-column .cat-icon{
            top: 9vw;
            right: 9vw;
        }
        .left-column .cat-icon img {
            width: 10vw;
            height: auto;
        }
        .left-column h1{
            margin-top: 2vh;
            font-size: 5vw;
            line-height: 3vw;
        }
        .left-column {
            width: 100vw;
        }
        .content {
            width: 80vw;
            margin-left: 10vw;
            top: 17vh;
            height: 83vh;
        }
        .project h2 {
            font-size: 1.665vw;
            font-weight: 400;
        }

        .project h3 {
            font-size: 1.4vw;
            font-weight: 400;
        }

        .project p {
            font-size: 1.04vw;
        }
    }

    @media (max-aspect-ratio: 1.45/1) {
        .left-column .immersive-view {
            display: none;
        }
    }

    @media (max-width: 1024px) {
        .left-column ul {
            font-size: 1.3vw;
        }
        .left-column {
            width: 100vw;
        }
        .project h2 {
            font-size: 2vw;
        }
        .project h3 {
            font-size: 1.8vw;
        }

        .project p {
            font-size: 1.4vw;
        }
    }

    @media (max-width: 768px) {
        .left-column {
            width: 100vw;
        }
        .project h2 {
            font-size: 4vw;
        }

        .project h3 {
            font-size: 3.5vw;
        }

        .project p {
            font-size: 2.8vw;
        }
    }

    .custom-line {
        border: none;
        margin-bottom: 3vw;
        height: 0.5px;
        background-color: black;
        width: 100%;
    }

    .iframe-container {
        position: relative;
        width: 80%;
        margin-left: 10%;
        margin-top: 6vh;
        padding-bottom: 45%;
        height: 0;
        overflow: hidden;
    }
    .iframe-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }
</style>
