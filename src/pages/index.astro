---
import '../styles/fonts.css';
import '../styles/diner.css';
import { featuredProjects } from '../data/projects';
import { profile } from '../data/profile';
import OtherWorkMenu from '../components/OtherWorkMenu.astro';
import WorkMenu from '../components/WorkMenu.astro';
import { seats } from '../diner/seats';
import { roomAssetNames, roomAssetUrl, roomTextureNames, roomTextureUrl, touchAssetMedia } from '../diner/asset-urls';


---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#1b211e" />
    <title>After Hours — Felix’s Midnight Diner</title>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href="/fonts/font-6.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/font-5.ttf" as="font" type="font/ttf" crossorigin />
    <!-- Start the room downloads during HTML parsing, before the 3D module initializes. -->
    {roomAssetNames.map(name => (
      <>
        <link rel="preload" href={roomAssetUrl(name, true)} media={touchAssetMedia} as="fetch" crossorigin />
        <link rel="preload" href={roomAssetUrl(name)} media={`not all and ${touchAssetMedia}`} as="fetch" crossorigin />
      </>
    ))}
    {roomTextureNames.map(name => (
      <>
        <link rel="preload" href={roomTextureUrl(name, true)} media={touchAssetMedia} as="image" crossorigin />
        <link rel="preload" href={roomTextureUrl(name)} media={`not all and ${touchAssetMedia}`} as="image" crossorigin />
      </>
    ))}
  </head>
  <body>
    <main id="main" class="diner-shell">
      <div class="scene-fallback" aria-hidden="true"></div>
      <canvas id="diner-canvas" aria-label="An interactive three-dimensional midnight diner. Use the Work, Notebook, and About links to explore with a keyboard." tabindex="-1"></canvas>
      <div class="scene-vignette" aria-hidden="true"></div>
      <header class="diner-header">
        <a class="diner-brand" href="/" aria-label="After Hours home"><span class="brand-kicker">FELIX WANG’S</span><h1 class="brand-name">after hours</h1></a>
        <nav aria-label="Explore the diner">
          <a id="work" href="/work/" data-open="menu">Work</a>
          <a id="on-the-side" href="/work/#side-projects" data-open="notebook">Notebook</a>
          <a id="about" href="/work/#about-felix" data-open="about">About</a>
        </nav>
        <button class="sound-button utility-button" id="sound-toggle" type="button" aria-pressed="false" aria-label="Play lounge music and rain ambience" title="Play music"><span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button>
      </header>
      <div class="scene-loading" id="scene-loading">
        <svg class="loading-lamp" viewBox="0 0 120 130" fill="none" aria-hidden="true">
          <defs><linearGradient id="loading-light" x1="60" y1="71" x2="60" y2="125" gradientUnits="userSpaceOnUse"><stop stop-color="#e8c789" /><stop offset="1" stop-color="#e8c789" stop-opacity="0" /></linearGradient></defs>
          <path class="loading-beam" d="M42 71 12 125h96L78 71Z" />
          <path class="loading-cord" d="M60 0v42" />
          <path class="loading-shade" d="M28 68c8-3 13-26 32-26s24 23 32 26c-8 7-56 7-64 0Z" />
          <ellipse class="loading-bulb" cx="60" cy="70" rx="27" ry="3" />
        </svg>
        <h2 class="loading-title" id="loading-title">Opening for the night.</h2>
        <p class="loading-detail" id="loading-detail" role="status">Getting the room ready…</p>
        <div class="loading-progress" id="loading-progress" role="progressbar" aria-label="Preparing the diner" aria-valuemin="0" aria-valuemax="100"><span></span></div>
        <a class="loading-work" href="/work/">Browse the work while you wait <span aria-hidden="true">↗</span></a>
        <button class="loading-retry" id="loading-retry" hidden>Try the room again</button>
      </div>
      <div class="hotspots" id="hotspots" aria-label="Objects in the diner">
        <button class="hotspot" data-hotspot="menu" data-action="menu" aria-label="Pick up the menu and explore selected projects" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">The menu</span></button>
        <button class="hotspot" data-hotspot="notebook" data-action="notebook" aria-label="Open the notebook of side projects" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">The notebook</span></button>
        <button class="hotspot" data-hotspot="cat" data-action="cat" aria-label="Say hello to the sleeping cat" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">The manager</span></button>
        <button class="hotspot" data-hotspot="record" data-action="record" aria-label="Play a record" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">Set the mood</span></button>
        <button class="hotspot" data-hotspot="about" data-action="about" aria-label="Meet Felix, the person behind the counter" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">Meet the host</span></button>
        <button class="hotspot" data-hotspot="door" data-action="door" aria-label="Open the door for a surprise visitor" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">Someone at the door</span></button>
        {Object.keys(seats).map((name, index) => (
          <button class="hotspot seat-hotspot" data-hotspot={name} data-action={name} aria-label={`Sit at seat ${index + 1}, ${['left end', 'left center', 'right center', 'right end'][index]} of the counter`} hidden>
            <span class="hotspot-dot" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <div class="scene-toast" id="scene-toast" role="status" aria-live="polite"></div>
      <footer class="diner-controls">
        <p class="gesture-hint" id="gesture-hint">Drag to explore · Pick a stool to sit</p>
        <div class="utility-controls">
          <button id="reset-view" class="utility-button" aria-label="Return to the wide view of the diner" title="Room view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6" /></svg></button>
          <details class="scene-options" id="view-options">
            <summary class="utility-button" id="view-options-toggle" aria-label="View options" title="View options"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /></svg></summary>
            <div class="options-menu">
              <p class="options-heading">Make yourself at home</p>
              <p id="controls-help">Drag to look around. Scroll to move closer. Choose a stool to sit.</p>
              <a href="/visitor-credits/">Visitor credits <span aria-hidden="true">↗</span></a>
              <a href="/work/">Simple portfolio <span aria-hidden="true">↗</span></a>
            </div>
          </details>
        </div>
      </footer>
      <noscript><style is:inline>.scene-loading,.diner-controls{display:none}</style><div class="no-script">Welcome to After Hours. <a href="/work/">Explore the portfolio →</a></div></noscript>
    </main>

    <dialog class="diner-dialog" id="diner-dialog" aria-labelledby="dialog-title">
      <div class="dialog-toolbar"><button id="panel-back" hidden>← The menu</button><span class="dialog-location" id="dialog-location">AT THE COUNTER</span><button id="panel-close" aria-label="Close and return to the diner">Close <span aria-hidden="true">×</span></button></div>
      <div class="dialog-scroll" id="dialog-scroll">
        <section data-panel="menu" class="paper-panel menu-panel">
          <div class="paper-border">
            <p class="paper-eyebrow">FELIX WANG’S</p><h2 class="menu-logo" id="dialog-title">after hours</h2>
            <div class="menu-intro"><h3>House specials.</h3></div>
            <WorkMenu interactive />
            <p class="menu-signature">Thanks for stopping by, <em>Felix</em></p>
          </div>
        </section>
        <section data-panel="other-work" class="paper-panel other-work-panel" hidden>
          <p class="paper-eyebrow">OTHER WORK</p><h2 class="panel-heading">À la carte.</h2>
          <OtherWorkMenu />
          <div class="story-footer"><button data-panel-back>Back to the menu →</button></div>
        </section>
        <section data-panel="notebook" class="paper-panel notebook-panel" hidden>
          <p class="paper-eyebrow">OFF THE MAIN MENU / PERSONAL NOTEBOOK</p><h2 class="panel-heading">Off the clock.<br /><em>Still making.</em></h2><p class="panel-intro">Games, art, and theatre. Things I keep coming back to.</p>
          <article class="notebook-entry"><img src="/images/ow04.webp" alt="Felix’s indie game projects" width="600" height="420" loading="lazy" /><div><span class="paper-eyebrow">01 / PLAY</span><h3>Just one more level.</h3><p>I’ve been making indie games since 2018. I like building worlds as much as getting lost in them.</p></div></article>
          <article class="notebook-entry"><img src="/images/ow02.webp" alt="A selection of Felix’s fine art" width="600" height="420" loading="lazy" /><div><span class="paper-eyebrow">02 / MAKE</span><h3>Thinking with my hands.</h3><p>Drawing and making art since 2017. A place to work with color, composition, and ideas that don’t need a product brief.</p></div></article>
          <article class="notebook-entry"><img src="/images/theatre.webp" alt="Felix performing in a theatre production" width="1200" height="945" loading="lazy" /><div><span class="paper-eyebrow">03 / PERFORM</span><h3>On stage.</h3><p>I’ve been acting in theatre since 2015. Another way to work with characters, timing, and an audience.</p></div></article>
        </section>
        <section data-panel="about" class="paper-panel about-panel" hidden>
          <p class="paper-eyebrow">A NOTE FROM BEHIND THE COUNTER</p><h2 class="panel-heading">Hi, I’m Felix.<br /><em>Glad you’re here.</em></h2>
          <div class="about-portrait"><img src="/images/profile.webp" alt="Yifei Felix Wang" width="400" height="400" loading="lazy" /><span>Builder. Player.<br />Perpetually curious.</span></div>
          <p>{profile.bio}</p><p>{profile.personal}</p>
          <div class="contact-card"><span class="paper-eyebrow">HAVE SOMETHING IN MIND?</span><a href="mailto:wangyifeifelix@gmail.com">Let’s talk <span>↗</span></a><p>wangyifeifelix@gmail.com</p></div>
          <div class="about-links"><a href="https://www.linkedin.com/in/felix-wang1" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://x.com/felixyifeiwang" target="_blank" rel="noreferrer">X ↗</a><a href="https://github.com/FelixYifeiWang" target="_blank" rel="noreferrer">GitHub ↗</a></div>
        </section>
        {featuredProjects.map(project => <section class="paper-panel project-panel" data-panel={`project-${project.slug}`} data-story-group={project.featured ? 'HOUSE SPECIAL' : 'OTHER WORK'} hidden>
          <p class="paper-eyebrow">{project.featured ? `HOUSE SPECIAL ${project.number}` : 'OTHER WORK'} / {project.type.toUpperCase()}</p><h2 class="panel-heading">{project.name}</h2><p class="project-intro">{project.intro}</p>
          <dl class="story-meta"><div><dt>YEAR</dt><dd>{project.year}</dd></div><div><dt>{project.brief ? 'FOCUS' : 'MY ROLE'}</dt><dd>{project.role}</dd></div><div><dt>TOOLS</dt><dd>{project.tools}</dd></div></dl>
          {project.cover && <img class="story-cover" src={`/images/${project.cover}.webp`} alt={project.coverAlt || `${project.name} project presentation`} width="1600" height="900" loading="lazy" />}
          <div class="story-section"><h3>The work.</h3><p>{project.story}</p></div>{project.approach && <div class="story-section"><h3>Key decisions.</h3><p>{project.approach}</p><p>{project.detail}</p></div>}
          {project.gallery && <img class="story-gallery" src={`/images/${project.gallery}.webp`} alt={project.galleryAlt || `A closer look at ${project.name}`} width="1600" height="900" loading="lazy" />}
          {project.note && <p class="story-note">{project.note}</p>}
          <div class="story-footer"><button data-panel-back>Back to the menu →</button></div>
        </section>)}
      </div>
    </dialog>
    <script>
      import { initDiner } from '../diner/ui';
      initDiner();
    </script>
  </body>
</html>
