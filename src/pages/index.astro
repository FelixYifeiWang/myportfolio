---
import '../styles/fonts.css';
import '../styles/diner.css';
import { projects } from '../data/projects';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Step into After Hours, Felix Wang’s midnight diner for technology, games, art, and curious ideas. Pick up the menu and explore the work." />
    <meta name="theme-color" content="#1b211e" />
    <title>After Hours — Felix’s Midnight Diner</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/font-6.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/font-5.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <main id="main" class="diner-shell">
      <div class="scene-fallback" aria-hidden="true"></div>
      <canvas id="diner-canvas" aria-label="An interactive three-dimensional midnight diner. Use the Work, Notebook, and About links to explore with a keyboard." tabindex="-1"></canvas>
      <div class="scene-vignette" aria-hidden="true"></div>
      <header class="diner-header">
        <a class="diner-brand" href="/" aria-label="After Hours home"><span class="brand-kicker">FELIX WANG’S</span><h1 class="brand-name">after hours<span class="brand-star" aria-hidden="true">✳</span></h1></a>
        <nav aria-label="Explore the diner">
          <a id="work" href="/work/" data-open="menu">Work</a>
          <a id="on-the-side" href="/work/#side-projects" data-open="notebook">Notebook</a>
          <a id="about" href="/work/#about-felix" data-open="about">About</a>
        </nav>
        <button class="sound-button utility-button" id="sound-toggle" type="button" aria-pressed="false" aria-label="Turn on the original lounge music and rain ambience" title="Sound off"><span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span></button>
      </header>
      <div class="scene-loading" id="scene-loading" role="status"><span></span>Turning the lights on…</div>
      <div class="hotspots" id="hotspots" aria-label="Objects in the diner">
        <button class="hotspot" data-hotspot="menu" data-action="menu" aria-label="Pick up the menu and explore selected projects" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">The menu</span></button>
        <button class="hotspot" data-hotspot="notebook" data-action="notebook" aria-label="Open the notebook of side projects" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">The notebook</span></button>
        <button class="hotspot" data-hotspot="cat" data-action="cat" aria-label="Say hello to the sleeping cat" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">The manager</span></button>
        <button class="hotspot" data-hotspot="record" data-action="record" aria-label="Play or pause the record player" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">Set the mood</span></button>
        <button class="hotspot" data-hotspot="about" data-action="about" aria-label="Meet Felix, the person behind the counter" hidden><span class="hotspot-dot" aria-hidden="true"></span><span class="hotspot-label" aria-hidden="true">Meet the host</span></button>
      </div>
      <div class="scene-toast" id="scene-toast" role="status" aria-live="polite"></div>
      <footer class="diner-controls">
        <p class="gesture-hint" id="gesture-hint">Drag to look around</p>
        <button id="take-seat" class="take-seat" disabled>Take a seat <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></button>
        <div class="utility-controls">
          <button id="reset-view" class="utility-button" aria-label="Return to the wide view of the diner" title="Room view" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6" /></svg></button>
          <details class="scene-options" id="view-options">
            <summary class="utility-button" id="view-options-toggle" aria-label="View options" title="View options"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /></svg></summary>
            <div class="options-menu">
              <p class="options-heading">Make yourself at home</p>
              <p id="controls-help">Drag to look around. Scroll to move closer.</p>
              <a href="/work/">Simple portfolio <span aria-hidden="true">↗</span></a>
            </div>
          </details>
        </div>
      </footer>
      <noscript><div class="no-script">Welcome to After Hours. <a href="/work/">Explore the portfolio →</a></div></noscript>
    </main>

    <dialog class="diner-dialog" id="diner-dialog" aria-labelledby="dialog-title">
      <div class="dialog-toolbar"><button id="panel-back" hidden>← The menu</button><span class="dialog-location" id="dialog-location">AT THE COUNTER</span><button id="panel-close" aria-label="Close and return to the diner">Close <span aria-hidden="true">×</span></button></div>
      <div class="dialog-scroll" id="dialog-scroll">
        <section data-panel="menu" class="paper-panel menu-panel">
          <div class="paper-border">
            <p class="paper-eyebrow">FELIX WANG’S</p><h2 class="menu-logo" id="dialog-title">after hours</h2><p class="menu-subtitle">THE MIDNIGHT MENU</p>
            <div class="menu-rule"><span>✳</span></div>
            <div class="menu-intro"><h3>House specials.</h3><span>SELECTED WORK<br />2021 — 2024</span></div>
            <p class="menu-intro-copy">A few things I’ve made with curiosity, care,<br />and the occasional very late night.</p>
            <div class="diner-menu-items">{projects.map(project => <a class="diner-menu-item" href={`/work/${project.slug}/`} data-project={project.slug}><span class="dish-number">{project.number}</span><div class="dish-info"><div class="dish-name"><h4>{project.name}</h4><span class="dish-dots"></span><span class="dish-year">{project.year}</span></div><p>{project.description}</p><span class="dish-type">{project.type}</span></div><span class="dish-arrow" aria-hidden="true">↗</span></a>)}</div>
            <div class="menu-bottom-note"><span>Made from scratch.</span><span>Best shared with good company.</span></div>
            <p class="menu-signature">Thanks for stopping by, <em>Felix</em></p>
          </div>
        </section>
        <section data-panel="notebook" class="paper-panel notebook-panel" hidden>
          <p class="paper-eyebrow">OFF THE MAIN MENU / PERSONAL NOTEBOOK</p><h2 class="panel-heading">Little ideas.<br /><em>Long detours.</em></h2><p class="panel-intro">Games, art, objects. Sometimes the side quest is the interesting part.</p>
          <article class="notebook-entry"><img src="/images/ow04.webp" alt="Felix’s indie game projects" width="600" height="420" loading="lazy" /><div><span class="paper-eyebrow">01 / PLAY</span><h3>Just one more level.</h3><p>I’ve been making indie games since 2018. Worlds, characters, and the feeling of discovery keep bringing me back.</p><a href="/work/echo-of-mobius/" data-project="echo-of-mobius">A world I helped build ↗</a></div></article>
          <article class="notebook-entry"><img src="/images/ow02.webp" alt="A selection of Felix’s fine art" width="600" height="420" loading="lazy" /><div><span class="paper-eyebrow">02 / MAKE</span><h3>Thinking with my hands.</h3><p>Drawing, making, and following an idea without needing to know exactly where it will end up. An ongoing practice since 2017.</p></div></article>
          <article class="notebook-entry"><img src="/images/ow3.webp" alt="Custom 3D-printed toy designs made with Inkheart" width="600" height="420" loading="lazy" /><div><span class="paper-eyebrow">03 / TINKER</span><h3>Ideas you can hold.</h3><p>Custom 3D-printed toys with Inkheart. Taking something out of the screen and figuring out how it should feel in your hands.</p></div></article>
        </section>
        <section data-panel="about" class="paper-panel about-panel" hidden>
          <p class="paper-eyebrow">A NOTE FROM BEHIND THE COUNTER</p><h2 class="panel-heading">Hi, I’m Felix.<br /><em>Glad you’re here.</em></h2>
          <div class="about-portrait"><img src="/images/profile.webp" alt="Yifei Felix Wang" width="400" height="400" loading="lazy" /><span>Builder. Player.<br />Perpetually curious.</span></div>
          <p>I build cool tech stuff to make people happy. Sometimes that’s a game, sometimes a tool, sometimes something a little harder to put in a category.</p><p>I care about how things work and how they make you feel. Outside of making things: art, cats, a very good meal, and finding the next place worth going back to.</p>
          <div class="contact-card"><span class="paper-eyebrow">THERE’S ALWAYS ROOM FOR A CONVERSATION</span><a href="mailto:wangyifeifelix@gmail.com">Say hello <span>↗</span></a><p>wangyifeifelix@gmail.com</p></div>
          <div class="about-links"><a href="https://github.com/FelixYifeiWang" target="_blank" rel="noreferrer">GitHub ↗</a><a href="https://www.linkedin.com/in/felix-wang1" target="_blank" rel="noreferrer">LinkedIn ↗</a></div>
        </section>
        {projects.map(project => <section class="paper-panel project-panel" data-panel={`project-${project.slug}`} hidden>
          <p class="paper-eyebrow">HOUSE SPECIAL {project.number} / {project.type.toUpperCase()}</p><h2 class="panel-heading">{project.name}</h2><p class="project-intro">{project.intro}</p>
          <dl class="story-meta"><div><dt>YEAR</dt><dd>{project.year}</dd></div><div><dt>MY ROLE</dt><dd>{project.role}</dd></div><div><dt>TOOLS</dt><dd>{project.tools}</dd></div></dl>
          <img class="story-cover" src={`/images/${project.cover}.webp`} alt={`${project.name} project presentation`} width="1600" height="900" loading="lazy" />
          <div class="story-section"><h3>The idea.</h3><p>{project.story}</p></div><div class="story-section"><h3>In the making.</h3><p>{project.approach}</p><p>{project.detail}</p></div>
          <img class="story-gallery" src={`/images/${project.gallery}.webp`} alt={`A closer look at ${project.name}`} width="1600" height="900" loading="lazy" />
          <div class="story-footer"><a href={`/work/${project.slug}/`}>Open the standalone story ↗</a><button data-action="menu">Back to the menu →</button></div>
        </section>)}
      </div>
    </dialog>
    <script>
      import { initDiner } from '../diner/ui';
      initDiner();
    </script>
  </body>
</html>
