---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---
<Layout>
  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> A PERSONAL STUDIO. ALWAYS CURIOUS.</p>
        <h1 id="hero-title">Good things,<br /><em>after hours.</em></h1>
        <p class="hero-intro">I’m Felix. I build things at the intersection of <strong>technology, games, and art.</strong> Welcome to my little corner of the internet.</p>
        <a class="text-link hero-link" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="counter-scene" id="counter-scene">
        <img src="/images/after-hours-counter.webp" alt="A sleeping orange cat beside an espresso, a handheld game, and a burgundy lamp on a warmly lit wooden counter." width="1500" height="1000" fetchpriority="high" />
        <button class="cat-note" id="cat-note" type="button" aria-label="Say hello to the sleeping studio cat"><span aria-hidden="true">z z z</span></button>
        <figcaption><span class="tiny-star" aria-hidden="true">✳</span> Make yourself at home.</figcaption>
        <span class="cat-response" id="cat-response" role="status"></span>
      </figure>
      <div class="hero-bottom"><span>TECHNOLOGY · PLAY · A LITTLE SOUL</span><span>SCROLL TO THE GOOD STUFF <span aria-hidden="true">↓</span></span></div>
    </section>

    <section class="menu-section wrap" id="work" aria-labelledby="work-title">
      <div class="menu-paper">
        <div class="menu-topline"><span>THE PORTFOLIO MENU</span><span>SELECTED WORK / 2021—2024</span></div>
        <div class="menu-heading"><div><p class="eyebrow">MADE FROM SCRATCH</p><h2 id="work-title">House specials<span class="rust">.</span></h2></div><p>A few projects from the kitchen.<br />Best enjoyed with a little curiosity.</p></div>
        <div class="project-menu">
          {projects.map(project => <a class="menu-item" href={`/work/${project.slug}/`}>
            <span class="item-number">{project.number}</span>
            <div class="item-image"><img src={`/images/${project.image}.webp`} alt="" width="144" height="100" loading="lazy" /></div>
            <div class="item-copy"><h3>{project.name}{project.number === '01' && <span class="house-favorite">HOUSE FAVORITE</span>}</h3><p>{project.description}</p><span class="item-type">{project.type}</span></div>
            <span class="item-year">{project.year}</span><span class="item-arrow" aria-hidden="true">↗</span>
          </a>)}
        </div>
        <div class="menu-bottom"><span>Thoughtfully made. Occasionally unconventional.</span><span aria-hidden="true">✳</span><span>Five courses. Many curiosities.</span></div>
      </div>
    </section>

    <section class="side-section wrap" id="on-the-side" aria-labelledby="side-title">
      <div class="section-heading"><div><p class="eyebrow">OFF THE MAIN MENU</p><h2 id="side-title">A little on the side.</h2></div><p>Other ways to keep the hands busy<br />and the imagination well fed.</p></div>
      <div class="side-grid">
        <details class="side-item"><summary><div class="side-image"><img src="/images/ow04.webp" alt="A selection of Felix’s indie game work" width="600" height="420" loading="lazy" /></div><div class="side-label"><h3>Just one more level.</h3><span aria-hidden="true">+</span></div><p>Indie games & playful worlds</p></summary><div class="side-description">I’ve been making indie games since 2018. World-building, characters, and the feeling of discovery keep bringing me back.<a href="/work/echo-of-mobius/">Explore Echo of Mobius ↗</a></div></details>
        <details class="side-item"><summary><div class="side-image"><img src="/images/ow02.webp" alt="A selection of Felix’s fine art" width="600" height="420" loading="lazy" /></div><div class="side-label"><h3>Thinking with my hands.</h3><span aria-hidden="true">+</span></div><p>Fine art & visual experiments</p></summary><div class="side-description">A place for drawing, making, and following an idea without needing to know where it will end up. I’ve been exploring fine art since 2017.</div></details>
        <details class="side-item"><summary><div class="side-image"><img src="/images/ow3.webp" alt="Custom 3D-printed toy designs" width="600" height="420" loading="lazy" /></div><div class="side-label"><h3>Ideas you can hold.</h3><span aria-hidden="true">+</span></div><p>Objects, toys & small inventions</p></summary><div class="side-description">Custom 3D-printed toys made with Inkheart: a chance to take an idea out of the screen, work through the details, and turn it into something physical.</div></details>
      </div>
    </section>

    <section class="about-section wrap" id="about" aria-labelledby="about-title">
      <div class="about-note"><span class="eyebrow">A NOTE FROM THE KITCHEN</span><h2 id="about-title">Hi, I’m Felix.<br /><em>Glad you stopped by.</em></h2><p>I build cool tech stuff to make people happy. Sometimes that’s a game, sometimes a tool, sometimes something a little harder to put in a category.</p><p>I care about how things work and how they make you feel. Outside of making things: art, cats, a very good meal, and finding the next place worth going back to.</p><a class="text-link" href="mailto:wangyifeifelix@gmail.com">Let’s make something good <span aria-hidden="true">↗</span></a></div>
      <aside class="receipt" aria-label="Personal interests"><div class="receipt-title">AFTER HOURS</div><p class="receipt-subtitle">THE HOUSE RECIPE</p><div class="receipt-rule"></div><div class="receipt-line"><span>Curiosity</span><span>A generous helping</span></div><div class="receipt-line"><span>Technology</span><span>With a human touch</span></div><div class="receipt-line"><span>Games & art</span><span>Always on the menu</span></div><div class="receipt-line"><span>Good food</span><span>Non-negotiable</span></div><div class="receipt-line"><span>Cats</span><span>In charge, probably</span></div><div class="receipt-rule"></div><p class="receipt-end">THANK YOU FOR BEING HERE<br /><span aria-hidden="true">✳ ✳ ✳</span></p></aside>
    </section>
  </main>
  <script>
    const scene = document.querySelector<HTMLElement>('#counter-scene');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (scene && window.matchMedia('(pointer: fine)').matches) {
      scene.addEventListener('pointermove', event => {
        if (reducedMotion.matches) return;
        const rect = scene.getBoundingClientRect();
        scene.style.setProperty('--scene-x', `${(event.clientX - rect.left - rect.width / 2) / 100}deg`);
        scene.style.setProperty('--scene-y', `${-(event.clientY - rect.top - rect.height / 2) / 140}deg`);
      });
      scene.addEventListener('pointerleave', () => { scene.style.setProperty('--scene-x', '0deg'); scene.style.setProperty('--scene-y', '0deg'); });
    }
    const cat = document.querySelector<HTMLButtonElement>('#cat-note');
    const response = document.querySelector<HTMLElement>('#cat-response');
    let reset: ReturnType<typeof setTimeout>;
    cat?.addEventListener('click', () => {
      if (!response) return;
      clearTimeout(reset);
      response.textContent = 'The manager is on a break. Prrr.';
      response.classList.add('visible');
      reset = setTimeout(() => { response.classList.remove('visible'); response.textContent = ''; }, 4500);
    });
  </script>
</Layout>
