---
import Layout from '../../layouts/Layout.astro';
import ProjectFlow from '../../components/ProjectFlow.astro';
import { projects } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: projects[(index + 1) % projects.length] } }));
}
const { project, next } = Astro.props;
---
<Layout title={`${project.name} — After Hours / Felix Wang`} description={project.description}>
  <main id="main" class="project-page wrap">
    <a class="back-link" href={project.featured ? "/work/" : "/work/other/"}>← {project.featured ? 'Back to the menu' : 'Other work'}</a>
    <div class="project-heading">
      <p class="eyebrow">{project.featured ? `HOUSE SPECIAL ${project.number}` : 'OTHER WORK'} / {project.type.toUpperCase()}</p>
      <h1>{project.name}</h1>
      <p class="project-deck">{project.intro}</p>
    </div>
    <dl class="project-meta"><div><dt>Year</dt><dd>{project.year}</dd></div><div><dt>{project.brief ? 'Focus' : 'My role'}</dt><dd>{project.role}</dd></div><div><dt>Ingredients</dt><dd>{project.tools}</dd></div></dl>
    {project.outcomes.length > 0 && <dl class="project-outcomes" aria-label="Project outcomes">{project.outcomes.map(outcome => <div><dt>{outcome.label}</dt><dd>{outcome.value}</dd></div>)}</dl>}
    {project.flow && <ProjectFlow flow={project.flow} />}
    {project.cover && <img class="project-cover" src={`/images/${project.cover}.webp`} alt={project.coverAlt || `${project.name} project presentation`} width="1600" height="900" fetchpriority="high" />}
    <section class="project-story" aria-labelledby="idea-title"><h2 id="idea-title">{project.brief ? 'My contribution.' : 'The idea.'}</h2><div><p>{project.story}</p></div></section>
    {project.approach && <section class="project-story" aria-labelledby="process-title"><h2 id="process-title">In the making.</h2><div><p>{project.approach}</p><p>{project.detail}</p></div></section>}
    {project.gallery && <img class="project-gallery" src={`/images/${project.gallery}.webp`} alt={project.galleryAlt || `A closer look at the ${project.name} project`} width="1600" height="900" loading="lazy" />}
    {project.note && <p class="source-note">{project.note}</p>}
    <a class="next-project" href={`/work/${next.slug}/`}><div><p>UP NEXT / MORE WORK</p><h2>{next.name}</h2></div><span aria-hidden="true">↗</span></a>
    <p class="source-note">Selected work from {project.year}. <a href="mailto:wangyifeifelix@gmail.com">Get in touch to talk about the process.</a></p>
  </main>
</Layout>
