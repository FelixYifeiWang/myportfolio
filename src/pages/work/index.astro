---
import '../../styles/fonts.css';
import '../../styles/diner.css';
import WorkMenu from '../../components/WorkMenu.astro';
import { profile } from '../../data/profile';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.description} />
    <title>The menu — After Hours / Felix Wang</title>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  </head>
  <body>
    <main id="main" class="static-work-page">
      <a class="static-back" href="/">← Step into the diner</a>
      <article>
        <p class="paper-eyebrow">FELIX WANG’S AFTER HOURS</p>
        <h1>House specials.</h1>
        <WorkMenu />
        <section id="side-projects"><h2>Off the clock.</h2><p>Indie games, art, and theatre. Things I keep coming back to.</p><a href="/#on-the-side">Open the notebook ↗</a></section>
        <section id="about-felix"><h2>Hi, I’m Felix.</h2><p>{profile.bio}</p><p>{profile.personal}</p><p><a href="mailto:wangyifeifelix@gmail.com">wangyifeifelix@gmail.com ↗</a></p><div class="about-links"><a href="https://www.linkedin.com/in/felix-wang1" target="_blank" rel="noreferrer">LinkedIn ↗</a><a href="https://x.com/felixyifeiwang" target="_blank" rel="noreferrer">X ↗</a><a href="https://github.com/FelixYifeiWang" target="_blank" rel="noreferrer">GitHub ↗</a></div></section>
      </article>
    </main>
  </body>
</html>
