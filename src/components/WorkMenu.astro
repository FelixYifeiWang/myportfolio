---
import { featuredProjects } from '../data/projects';
import OtherWorkMenu from './OtherWorkMenu.astro';
interface Props { interactive?: boolean; }
const { interactive = false } = Astro.props;
---
<div class="diner-menu-items">
  {featuredProjects.map(project => <a class="diner-menu-item" href={`/work/${project.slug}/`} data-project={interactive ? project.slug : undefined}>
    <span class="dish-number">{project.number}</span>
    <div class="dish-info"><div class="dish-name"><h4>{project.name}</h4></div><p>{project.menuDescription}</p></div>
    <span class="dish-arrow" aria-hidden="true">↗</span>
  </a>)}
</div>
<details class="other-work-menu" id="other-work">
  <summary><span class="other-work-title">Other work.</span><span class="other-work-toggle" aria-hidden="true">+</span></summary>
  <OtherWorkMenu interactive={interactive} />
</details>
