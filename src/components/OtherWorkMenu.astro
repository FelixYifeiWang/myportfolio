---
import { otherProjects } from '../data/projects';
const categories = ['New interfaces', 'Software & AI', 'Physical systems'];
---
<div class="a-la-carte">
  {categories.map(category => <section class="menu-course" aria-label={category}>
    <h3>{category}</h3>
    {otherProjects.filter(project => project.category === category).map(project => <details class="side-dish" id={`work-${project.slug}`}>
      <summary><span class="side-dish-body"><span class="side-dish-name">{project.name}</span><span class="side-dish-caption">{project.brief ? project.intro : project.menuDescription}</span></span><span class="side-dish-toggle" aria-hidden="true">+</span></summary>
      <div class="side-dish-detail">
        <p>{project.story}</p>
        {project.cover && <img src={`/images/${project.cover}.webp`} alt={project.coverAlt || `${project.name} project presentation`} width="1600" height="900" loading="lazy" />}
        {!project.brief && <p>{project.detail}</p>}
        <p class="side-dish-tools">{project.tools}</p>
      </div>
    </details>)}
  </section>)}
</div>
<script>
  import { DisclosureMotion } from '../diner/disclosure-motion';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLDetailsElement>('.side-dish').forEach(details => {
    const summary = details.querySelector<HTMLElement>('summary')!;
    const content = details.querySelector<HTMLElement>('.side-dish-detail')!;
    const motion = new DisclosureMotion(details, summary, content, () => reduced.matches);
    summary.addEventListener('click', event => {
      event.preventDefault();
      motion.toggle();
    });
  });
</script>
