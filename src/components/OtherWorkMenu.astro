---
import { otherProjects } from '../data/projects';
interface Props { interactive?: boolean; }
const { interactive = false } = Astro.props;
const categories = ['New interfaces', 'Software & AI', 'Physical systems'];
const orderedProjects = categories.flatMap(category => otherProjects.filter(project => project.category === category));
---
<div class="other-work-list">
  {orderedProjects.map(project => <a class="side-dish" href={`/work/${project.slug}/`} data-project={interactive ? project.slug : undefined}>
    <div class="side-dish-body"><h4>{project.name}</h4><p>{project.brief ? project.intro : project.menuDescription}</p></div><span class="side-dish-arrow" aria-hidden="true">↗</span>
  </a>)}
</div>
