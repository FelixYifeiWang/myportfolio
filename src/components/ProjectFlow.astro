---
import type { Project } from '../data/projects';
interface Props { flow: NonNullable<Project['flow']>; }
const { flow } = Astro.props;
---
<figure class="project-flow">
  <figcaption>{flow.title}</figcaption>
  <ol>{flow.steps.map((step, index) => <li><span class="flow-index">0{index + 1}</span><h3>{step.name}</h3><p>{step.detail}</p></li>)}</ol>
  <span class="flow-caption">SYSTEM OVERVIEW</span>
</figure>
<style>
  .project-flow { margin: 32px 0; padding: 28px; border: 1px solid #99816b44; border-radius: 3px; background: #8174620a; color: inherit; }
  figcaption { font: 22px/1.2 var(--serif); margin-bottom: 28px; }
  ol { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); list-style: none; padding: 0; margin: 0; gap: 24px; }
  li { border-top: 1px solid #99816b66; padding-top: 12px; }
  .flow-index, .flow-caption { font: 9px/1.5 var(--mono); opacity: .65; letter-spacing: .06em; }
  h3 { font: 23px/1.2 var(--serif); margin: 10px 0 8px; }
  p { font-size: 12px; line-height: 1.65; opacity: .8; margin: 0; }
  .flow-caption { display: block; margin-top: 28px; }
  @media(max-width: 520px) { .project-flow { padding: 22px; } ol { grid-template-columns: 1fr; gap: 20px; } figcaption { margin-bottom: 22px; } h3 { margin-top: 6px; } }
</style>
